expression Archivos_SharePoint =
		let
		    Origen = SharePoint.Files(RutaSharePoint, [ApiVersion = 15])
		in
		    Origen
	lineageTag: 868c1b7a-f0f8-4894-b6f2-7b9a6f41515b
	queryGroup: 01_Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression ColumnasKardex =
		let
		    Origen = {"PERIODO", "CODIGO", "DESCRIPTOR", "STOCK", "COSTO", "VALORIZACION", "FULCOM", "UNID CONV", "LINEA", "NOMBRE LINEA", "POLITICA CJE AL 30SEP"}
		in
		    Origen
	lineageTag: 44bab9d0-c462-4b48-9681-4c7af64f9550
	queryGroup: 01_Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = List

expression fnLeerKardex =
		(archivo as binary) as table =>
		let
		    Libro = Excel.Workbook(archivo, null, true),
		    Hojas = Table.SelectRows(Libro, each
		        [Kind] = "Sheet" and Text.Upper(Text.Trim([Name])) = "DETALLE KARDEX"),
		    Datos = if Table.IsEmpty(Hojas)
		        then error "El archivo no tiene la hoja DETALLE KARDEX"
		        else Hojas{0}[Data],
		    Encabezados = Table.PromoteHeaders(Datos, [PromoteAllScalars = true]),
		    Columnas = Table.SelectColumns(Encabezados, ColumnasKardex),
		    EsVacio = (valor) => valor = null or Text.Trim(Text.From(valor)) = "",
		    EsNumero = (valor) => (try Number.From(valor) otherwise null) <> null,
		    SinBasura = Table.SelectRows(Columnas, each
		        not (EsVacio([CODIGO]) and EsVacio([STOCK]) and not EsNumero([COSTO])))
		in
		    SinBasura
	lineageTag: 58e02f6e-f1fa-4b2d-a026-60384dddf7fb
	queryGroup: 01_Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Function

expression Kardex_Origen =
		let
		    Archivos = Archivos_SharePoint,
		    Kardex = Table.SelectRows(Archivos, each
		        Text.EndsWith([Folder Path], "/" & CarpetaRaiz & "Kardex/")
		        and Text.StartsWith([Name], "kardex_")
		        and [Extension] = ".xlsx"),
		    ConPeriodo = Table.AddColumn(Kardex, "periodo_archivo", each
		        Date.EndOfMonth(Date.FromText(
		            Text.BetweenDelimiters([Name], "kardex_", ".xlsx") & "-01",
		            [Format = "yyyy-MM-dd"])), type date),
		    Leidos = Table.AddColumn(ConPeriodo, "datos", each fnLeerKardex([Content])),
		    Solo = Table.SelectColumns(Leidos, {"Name", "periodo_archivo", "datos"}),
		    Renombrado = Table.RenameColumns(Solo, {{"Name", "archivo"}}),
		    Expandido = Table.ExpandTableColumn(Renombrado, "datos", ColumnasKardex)
		in
		    Expandido
	lineageTag: 54482b3d-8094-4ca7-a3f9-4443f2de07aa
	queryGroup: 01_Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression Validar_Kardex =
		let
		    Origen = Table.Group(fact_kardex, {"periodo"}, {
		    {"filas", each Table.RowCount(_), Int64.Type},
		    {"valorizacion", each List.Sum(List.Transform([VALORIZACION], each try Number.From(_) otherwise 0)), type number}})
		in
		    Origen
	lineageTag: d0d9c435-f79c-40b1-ac92-dd4e7b2bfd74
	queryGroup: 99_Validacion

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression fnLeerBalanza =
		(archivo as binary) as table =>
		let
		    Libro = Excel.Workbook(archivo, null, true),
		    Hojas = Table.SelectRows(Libro, each
		        [Kind] = "Sheet" and Text.Upper(Text.Trim([Name])) = "FCV"),
		    Hoja = if Table.IsEmpty(Hojas)
		        then error "El archivo no tiene la hoja esperada de la balanza"
		        else Hojas{0}[Data],
		    ColumnaA = List.Transform(Hoja[Column1], each Text.Trim(Text.From(_) ?? "")),
		    Inicio = List.PositionOf(ColumnaA, "Cuenta"),
		    Fila1 = if Inicio = -1
		        then error "No se encontró la fila 'Cuenta' en la balanza"
		        else Record.ToList(Hoja{Inicio}),
		    Fila2 = Record.ToList(Hoja{Inicio + 1}),
		    FormatoOk =
		        Text.Contains(Text.From(Fila1{4}) ?? "", "Balance")
		        and Text.Trim(Text.From(Fila2{4}) ?? "") = "Débito"
		        and Text.Trim(Text.From(Fila2{5}) ?? "") = "Crédito",
		    Datos = if FormatoOk then Table.Skip(Hoja, Inicio + 2)
		        else error "La balanza no tiene las columnas de Balance donde se esperan",
		    Seleccion = Table.SelectColumns(Datos, {"Column1", "Column2", "Column5", "Column6"}),
		    Nombres = Table.RenameColumns(Seleccion, {
		        {"Column1", "cuenta"}, {"Column2", "descripcion"},
		        {"Column5", "balance_debito"}, {"Column6", "balance_credito"}})
		in
		    Nombres
	lineageTag: 0c586fd0-2611-45bb-9122-81f4508c4e54
	queryGroup: 01_Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Function

expression Balanza_Origen =
		let
		    Archivos = Archivos_SharePoint,
		    Balanzas = Table.SelectRows(Archivos, each
		        Text.EndsWith([Folder Path], "/" & CarpetaRaiz & "Balanza/")
		        and Text.StartsWith([Name], "balanza_")
		        and [Extension] = ".xlsx"),
		    ConPeriodo = Table.AddColumn(Balanzas, "periodo", each
		        Date.EndOfMonth(Date.FromText(
		            Text.BetweenDelimiters([Name], "balanza_", ".xlsx") & "-01",
		            [Format = "yyyy-MM-dd"])), type date),
		    Leidas = Table.AddColumn(ConPeriodo, "datos", each fnLeerBalanza([Content])),
		    Solo = Table.SelectColumns(Leidas, {"Name", "periodo", "datos"}),
		    Renombrado = Table.RenameColumns(Solo, {{"Name", "archivo"}}),
		    Expandido = Table.ExpandTableColumn(Renombrado, "datos",
		        {"cuenta", "descripcion", "balance_debito", "balance_credito"})
		in
		    Expandido
	lineageTag: 97133282-0e8c-4902-a562-10f58132431b
	queryGroup: 01_Origen

	annotation PBI_NavigationStepName = Navegación

