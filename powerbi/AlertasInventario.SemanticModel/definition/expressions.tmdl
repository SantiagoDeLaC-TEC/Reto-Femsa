	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

expression TipoCambio =
		let
		    Archivos = Archivos_SharePoint,
		    Archivo = Table.SelectRows(Archivos, each
		        Text.EndsWith([Folder Path], "/" & CarpetaRaiz & "TipoCambio/")
		        and [Name] = "tipo_cambio_clp_mxn.xlsx"),
		    Contenido = if Table.RowCount(Archivo) <> 1
		        then error "Se esperaba exactamente un archivo tipo_cambio_clp_mxn.xlsx"
		        else Archivo{0}[Content],
		    Libro = Excel.Workbook(Contenido, null, true),
		    Hojas = Table.SelectRows(Libro, each
		        [Kind] = "Sheet" and Text.Upper(Text.Trim([Name])) = "CONSULTA"),
		    Hoja = if Table.IsEmpty(Hojas)
		        then error "El archivo no tiene la hoja Consulta"
		        else Hojas{0}[Data],
		    ColumnaA = List.Transform(Hoja[Column1], each Text.Trim(Text.From(_) ?? "")),
		    Inicio = List.PositionOf(ColumnaA, "Fecha"),
		    Datos = if Inicio = -1
		        then error "No se encontró la fila 'Fecha' en el tipo de cambio"
		        else Table.Skip(Hoja, Inicio + 1),
		    Seleccion = Table.SelectColumns(Datos, {"Column1", "Column2"}),
		    Nombres = Table.RenameColumns(Seleccion, {{"Column1", "fecha"}, {"Column2", "tc"}}),
		    Tipos = Table.TransformColumns(Nombres, {
		        {"fecha", each try Date.From(_) otherwise null, type date},
		        {"tc", each try Number.From(_) otherwise null, type number}}),
		    Validas = Table.SelectRows(Tipos, each [fecha] <> null and [tc] <> null),
		    ConPeriodo = Table.AddColumn(Validas, "periodo", each Date.EndOfMonth([fecha]), type date),
		    Cierre = Table.Group(ConPeriodo, {"periodo"},
		        {{"tc_clp_mxn", each Table.Max(_, "fecha")[tc], type number}})
		in
		    Cierre
	lineageTag: c0d3d581-12a1-41e1-8cb8-53abfd6961d3
	queryGroup: 02_Staging

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

