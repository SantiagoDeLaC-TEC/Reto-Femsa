	/// Registros en REVISAR que ya lo estaban el mes anterior. Vacía en enero.
	measure 'Registros Alertas Recurrentes' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ),
			    fact_kardex[estado_general] = "REVISAR", fact_kardex[es_alerta_nueva] = FALSE () )
		formatString: 0
		displayFolder: 08 Calidad de Datos
		lineageTag: 91843c63-dfb3-4e5b-a54f-486fa4cc1cec

	/// Registros de la alerta de la fila. Usar con dim_calidad[alerta_calidad].
	measure 'Calidad Registros' =
			
			VAR o = SELECTEDVALUE ( dim_calidad[orden] )
			RETURN
			    COUNTROWS (
			        FILTER ( fact_kardex,
			            SWITCH ( o,
			                1, fact_kardex[flag_naturaleza_contraria],
			                2, fact_kardex[alerta_stock] = "Negativo",
			                3, fact_kardex[alerta_stock] = "Cero",
			                4, fact_kardex[alerta_stock] = "Sin dato",
			                5, fact_kardex[alerta_costo] = "Inválido",
			                6, fact_kardex[flag_dif_valorizacion],
			                7, fact_kardex[alerta_conversion] IN { "Inválido", "Revisar" },
			                8, fact_kardex[flag_duplicado],
			                9, fact_kardex[flag_fulcom_futura],
			                10, fact_kardex[tiene_nulos],
			                11, fact_kardex[estado_general] = "REVISAR",
			                FALSE ()
			            )
			        )
			    )
		formatString: 0
		displayFolder: 08 Calidad de Datos
		lineageTag: b44de622-1f5e-4350-b8c3-9fed34d984f8

	/// Valor neto de la alerta de la fila.
	measure 'Calidad Valor' =
			
			VAR o = SELECTEDVALUE ( dim_calidad[orden] )
			RETURN
			    SUMX (
			        FILTER ( fact_kardex,
			            SWITCH ( o,
			                1, fact_kardex[flag_naturaleza_contraria],
			                2, fact_kardex[alerta_stock] = "Negativo",
			                3, fact_kardex[alerta_stock] = "Cero",
			                4, fact_kardex[alerta_stock] = "Sin dato",
			                5, fact_kardex[alerta_costo] = "Inválido",
			                6, fact_kardex[flag_dif_valorizacion],
			                7, fact_kardex[alerta_conversion] IN { "Inválido", "Revisar" },
			                8, fact_kardex[flag_duplicado],
			                9, fact_kardex[flag_fulcom_futura],
			                10, fact_kardex[tiene_nulos],
			                11, fact_kardex[estado_general] = "REVISAR",
			                FALSE ()
			            )
			        ), fact_kardex[VALORIZACION]
			    )
		displayFolder: 08 Calidad de Datos
		lineageTag: 343845da-4336-4f63-9910-bda8c65c34a1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Valor sin signo de la alerta de la fila.
	measure 'Calidad Valor Absoluto' =
			
			VAR o = SELECTEDVALUE ( dim_calidad[orden] )
			RETURN
			    SUMX (
			        FILTER ( fact_kardex,
			            SWITCH ( o,
			                1, fact_kardex[flag_naturaleza_contraria],
			                2, fact_kardex[alerta_stock] = "Negativo",
			                3, fact_kardex[alerta_stock] = "Cero",
			                4, fact_kardex[alerta_stock] = "Sin dato",
			                5, fact_kardex[alerta_costo] = "Inválido",
			                6, fact_kardex[flag_dif_valorizacion],
			                7, fact_kardex[alerta_conversion] IN { "Inválido", "Revisar" },
			                8, fact_kardex[flag_duplicado],
			                9, fact_kardex[flag_fulcom_futura],
			                10, fact_kardex[tiene_nulos],
			                11, fact_kardex[estado_general] = "REVISAR",
			                FALSE ()
			            )
			        ), ABS(fact_kardex[VALORIZACION])
			    )
		displayFolder: 08 Calidad de Datos
		lineageTag: f01c4ae1-2ad5-4ecc-9e72-befc4f74fc92

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Registros de la alerta de la fila que entraron a REVISAR este mes. Cuenta registros nuevos en REVISAR, no la primera aparición de esa alerta específica.
	measure 'Calidad Nuevas' =
			
			VAR o = SELECTEDVALUE ( dim_calidad[orden] )
			RETURN
			    COUNTROWS (
			        FILTER ( FILTER ( fact_kardex, fact_kardex[es_alerta_nueva] = TRUE () ),
			            SWITCH ( o,
