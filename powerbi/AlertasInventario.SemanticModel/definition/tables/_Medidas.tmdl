	/// Registros sin alerta de antigüedad o sin estado general.
	measure 'Registros Sin Categoria' =
			
			CALCULATE (
			    COUNTROWS ( fact_kardex ),
			    REMOVEFILTERS ( fact_kardex ),
			    FILTER (
			        ALL ( fact_kardex[alerta_antiguedad], fact_kardex[estado_general] ),
			        ISBLANK ( fact_kardex[alerta_antiguedad] ) || ISBLANK ( fact_kardex[estado_general] )
			    )
			) + 0
		formatString: 0
		displayFolder: 10 Control
		lineageTag: fb15b1d3-93b1-4477-bd74-0f057860fc70

	/// Meses sin exactamente una fila de balanza (faltante o repetida).
	measure 'Periodos Balanza Invalida' =
			
			COUNTROWS (
			    FILTER (
			        ALL ( dim_calendario[periodo] ),
			        CALCULATE ( COUNTROWS ( fact_balanza ),
			            ALLEXCEPT ( dim_calendario, dim_calendario[periodo] ) ) <> 1
			    )
			) + 0
		formatString: 0
		displayFolder: 10 Control
		lineageTag: 5250edcb-d8a0-468c-a082-e386cf12aeba

	/// Meses del Kardex sin tipo de cambio.
	measure 'Periodos Sin Tipo Cambio' =
			
			CALCULATE ( COUNTROWS ( dim_calendario ),
			    REMOVEFILTERS ( dim_calendario ), ISBLANK ( dim_calendario[tc_clp_mxn] ) ) + 0
		formatString: 0
		displayFolder: 10 Control
		lineageTag: fd67484e-8bec-4e86-80ed-0eba8b96d4ff

	/// Meses con tipo de cambio ≥ 1 (probablemente invertido).
	measure 'Tipo Cambio Invalido' =
			
			CALCULATE ( COUNTROWS ( dim_calendario ),
			    REMOVEFILTERS ( dim_calendario ), dim_calendario[tc_clp_mxn] >= 1 ) + 0
		formatString: 0
		displayFolder: 10 Control
		lineageTag: fa82e6b6-f408-4026-8361-115ddb9eff63

	/// Registros cuyo periodo interno no coincide con el nombre de su archivo.
	measure 'Registros Periodo Inconsistente' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ),
			    REMOVEFILTERS ( fact_kardex ), fact_kardex[flag_periodo_inconsistente] = TRUE () ) + 0
		formatString: 0
		displayFolder: 10 Control
		lineageTag: f64167ec-b6c6-4ff6-a445-fa13dc79abea

	/// Suma de todos los problemas de control.
	measure 'Total Problemas Refresco' =
			
			[Registros Sin Categoria] + [Periodos Balanza Invalida] + [Periodos Sin Tipo Cambio]
			    + [Tipo Cambio Invalido] + [Registros Periodo Inconsistente]
		formatString: 0
		displayFolder: 10 Control
		lineageTag: d23a0ddd-d031-4f46-b91d-dd896c36ac6c

	/// "Sí" si no hay problemas; "No" si los hay. Para el indicador de la página 1.
	measure 'Refresco Valido' = IF ( [Total Problemas Refresco] = 0, "Sí", "No" )
		displayFolder: 10 Control
		lineageTag: 1ac53828-cad5-4ea9-8893-4aeb1768e334

	/// Colores base del dashboard. Cambiarlos aquí actualiza todo.
	measure 'Color Verde' = "#2E8B57"
		displayFolder: 11 Apoyo Visual
		lineageTag: ec53f3c9-15d6-43bc-8855-ace878e61a70

	/// Colores base del dashboard. Cambiarlos aquí actualiza todo.
	measure 'Color Ambar' = "#E69F00"
		displayFolder: 11 Apoyo Visual
		lineageTag: b4cfc9d8-d5be-41a4-acf6-88184f8b105e

	/// Colores base del dashboard. Cambiarlos aquí actualiza todo.
	measure 'Color Rojo' = "#C0392B"
		displayFolder: 11 Apoyo Visual
		lineageTag: 6a5d6d90-f296-4d0b-8b10-d7f64597406d

	/// Colores base del dashboard. Cambiarlos aquí actualiza todo.
	measure 'Color Gris' = "#7F7F7F"
		displayFolder: 11 Apoyo Visual
		lineageTag: ba72a985-c676-48f3-98c0-d37c00ea14fb

	/// Verde si concilia, rojo si no. Para el fondo de la tarjeta de conciliación (fx > Valor del campo).
	measure 'Color Conciliacion' =
			
			SWITCH ( [Estado Conciliacion],
			    "Conciliado", [Color Verde],
			    "No conciliado", [Color Rojo],
			    [Color Gris] )
		displayFolder: 11 Apoyo Visual
		lineageTag: d6feef3a-a7b0-4305-bf70-0517cb28ea95

	/// Color según Criterio Nivel. Para la columna de evaluación del semáforo.
	measure 'Color Nivel' =
			
			SWITCH ( [Criterio Nivel],
			    0, [Color Verde],
			    1, [Color Ambar],
			    2, [Color Rojo],
			    [Color Gris] )
		displayFolder: 11 Apoyo Visual
		lineageTag: 8937a73e-ad0e-42ef-8ce6-0892df499b1c

	/// Color de la categoría de antigüedad, tomado de dim_alerta. Para las barras de antigüedad.
	measure 'Color Alerta' = SELECTEDVALUE ( dim_alerta[color], [Color Gris] )
		displayFolder: 11 Apoyo Visual
		lineageTag: 33d73f23-045d-41f4-ac80-10d07758e30c

	/// Verde si el refresco es válido, rojo si no.
	measure 'Color Refresco' = IF ( [Refresco Valido] = "Sí", [Color Verde], [Color Rojo] )
		displayFolder: 11 Apoyo Visual
		lineageTag: 4b55f2fc-844b-4d3a-9644-4071197072ca

	/// "Cierre de [mes]". Para el título de cada página.
	measure 'Titulo Periodo' =
			
			"Cierre de " & SELECTEDVALUE ( dim_calendario[nombre_mes], "varios meses" )
		displayFolder: 11 Apoyo Visual
		lineageTag: 6c3b8fb2-cde8-4ffe-a2ff-57ce660fb0e2

	/// "Montos en CLP" o "Montos en MXN".
	measure 'Texto Moneda' = "Montos en " & [Moneda Seleccionada]
		displayFolder: 11 Apoyo Visual
		lineageTag: c4c1bb48-5df3-49ed-a4f6-cdd586220d36

	/// Aviso de que la conciliación usa el inventario total y no aplica filtros.
	measure 'Subtitulo Conciliacion' =
			
			"Inventario total; no aplica filtros de línea, política ni alerta"
		displayFolder: 11 Apoyo Visual
		lineageTag: 8b8fda63-915c-4c48-842b-c6d80b6b679e

	/// Línea y política filtradas, o "Todas". Para el subtítulo de cada página.
	measure 'Texto Filtros' =
			
			VAR lineas =
			    IF ( ISFILTERED ( dim_producto[LINEA] ),
			        CONCATENATEX ( VALUES ( dim_producto[LINEA] ), dim_producto[LINEA], ", " ),
			        "Todas" )
			VAR politicas =
			    IF ( ISFILTERED ( dim_producto[POLITICA CJE AL 30SEP] ),
			        CONCATENATEX ( VALUES ( dim_producto[POLITICA CJE AL 30SEP] ),
			            dim_producto[POLITICA CJE AL 30SEP], ", " ),
			        "Todas" )
			RETURN
			    "Línea: " & lineas & " · Política: " & politicas
		displayFolder: 11 Apoyo Visual
		lineageTag: d2451251-2927-4662-b0c2-0e8c28d97e59

	/// "+3.2 % vs. mes anterior". Para debajo de la tarjeta de valorización.
	measure 'Texto Variacion Valorizacion' =
			
			IF ( MAX ( dim_calendario[idx_mes] ) = 1, "Sin mes anterior",
			    FORMAT ( [Variacion %], "+0.0%;-0.0%;0.0%" ) & " vs. mes anterior" )
		displayFolder: 11 Apoyo Visual
		lineageTag: 6a17267f-a86d-47a5-b62e-457643218dd2

	/// "+12 vs. mes anterior". Para debajo de la tarjeta de SKU únicos.
	measure 'Texto Variacion SKU' =
			
			IF ( MAX ( dim_calendario[idx_mes] ) = 1, "Sin mes anterior",
			    FORMAT ( [Variacion SKU], "+#,0;-#,0;0" ) & " vs. mes anterior" )
		displayFolder: 11 Apoyo Visual
		lineageTag: 58204a6b-96e8-4af8-be0b-a8e984a3b500

	/// "N SKU concentran el 80 % del valor en Rojo".
	measure 'Texto Pareto' =
			
			FORMAT ( [SKU Pareto], "#,0" ) & " SKU concentran el "
			    & FORMAT ( [Pareto Pct], "0%" ) & " del valor en Rojo"
		displayFolder: 11 Apoyo Visual
		lineageTag: 132945a5-3b32-44b0-964d-f2c89f37a723

	/// "Datos validados" o "Revisar página de control". Para el indicador de la página 1.
	measure 'Texto Refresco' =
			
			IF ( [Refresco Valido] = "Sí", "Datos validados", "Revisar página de control" )
		displayFolder: 11 Apoyo Visual
		lineageTag: 1cc41e61-596f-43bc-9f4d-5b461ee59119

	partition _Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	annotation PBI_ResultType = Table

