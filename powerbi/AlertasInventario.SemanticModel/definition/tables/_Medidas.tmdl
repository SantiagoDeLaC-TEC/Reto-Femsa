	/// Versión de [medida] en la moneda elegida (CLP o MXN), convertida mes a mes con el tipo de cambio de cierre. Usar esta y no la original en páginas con segmentador de moneda.
	measure 'Valorizacion Kardex (moneda)' =
			
			SUMX ( VALUES ( dim_calendario[periodo] ), [Valorizacion Kardex] * [Factor Moneda] )
