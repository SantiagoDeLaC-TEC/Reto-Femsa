table _Medidas
	lineageTag: b2d58dc1-3dd8-4afe-94ba-36812cb752ff

	/// Tolerancia de conciliación Kardex vs. Balanza (0.1 %), leída de Parametros.xlsx.
	measure 'Tol Conciliacion' =
			
			CALCULATE ( MAX ( Parametros[valor_num] ), Parametros[parametro] = "tol_conciliacion" )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 Parámetros
		lineageTag: 0ae5c215-d62d-482f-8359-94a2bf465873

	/// Variación mensual a partir de la cual se marca "Revisar" (5 %), leída de Parametros.xlsx.
	measure 'Umbral Variacion' =
			
			CALCULATE ( MAX ( Parametros[valor_num] ), Parametros[parametro] = "umbral_variacion" )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 Parámetros
		lineageTag: c33df251-174e-4951-86ed-4b50053b743a

	/// Porcentaje acumulado del Pareto (80 %), leído de Parametros.xlsx.
	measure 'Pareto Pct' =
			
			CALCULATE ( MAX ( Parametros[valor_num] ), Parametros[parametro] = "pareto_pct" )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 01 Parámetros
		lineageTag: e2c2762d-37f2-4577-895b-af57da09757c

	/// Suma de la valorización del Kardex. Responde a todos los filtros (línea, política, alerta).
	measure 'Valorizacion Kardex' = SUM ( fact_kardex[VALORIZACION] )
		formatString: #,0
		displayFolder: 02 Conciliación
		lineageTag: 29a27649-ba05-406a-9359-e238b90ffa50

	/// Valorización del inventario completo de los meses seleccionados; ignora filtros de línea, política, alerta y clics. Usar siempre para conciliar.
	measure 'Valorizacion Kardex Total' =
			
			CALCULATE (
			    [Valorizacion Kardex],
			    REMOVEFILTERS ( fact_kardex ),
			    VALUES ( dim_calendario[periodo] )
			)
		formatString: #,0
		displayFolder: 02 Conciliación
		lineageTag: 1e13bff4-0362-4756-baa6-977ceb642e0d

	/// Saldo (débito − crédito) de la cuenta de existencias en la balanza.
	measure 'Saldo Balanza' = SUM ( fact_balanza[saldo] )
		formatString: #,0
		displayFolder: 02 Conciliación
		lineageTag: 78c226ca-99e1-4a0c-b197-e30f89132d1d

	/// Valorización Kardex total menos saldo de balanza, en CLP.
	measure Diferencia = [Valorizacion Kardex Total] - [Saldo Balanza]
		formatString: #,0
		displayFolder: 02 Conciliación
		lineageTag: f5324832-b2ff-4aac-84af-14703c2415a6

	/// Diferencia como proporción del saldo de balanza.
	measure 'Diferencia %' = DIVIDE ( [Diferencia], ABS ( [Saldo Balanza] ) )
		formatString: 0.000%;-0.000%;0.000%
		displayFolder: 02 Conciliación
		lineageTag: 804d3883-5195-44b8-9c36-805cf2d4a413

	/// "Conciliado" si la diferencia es ≤ 0.1 %; "No conciliado" si no; "Sin balanza" si falta el saldo del mes.
	measure 'Estado Conciliacion' =
			
			IF (
			    ISBLANK ( [Saldo Balanza] ),
			    "Sin balanza",
			    IF ( ABS ( [Diferencia %] ) <= [Tol Conciliacion], "Conciliado", "No conciliado" )
			)
		displayFolder: 02 Conciliación
		lineageTag: 26afe593-06ae-409e-90fa-f94902c0de50

	/// Evaluación del criterio Kardex vs. Balanza; igual a Estado Conciliacion.
	measure 'Eval Conciliacion' = [Estado Conciliacion]
		displayFolder: 03 Criterios
		lineageTag: 957e0070-1383-4940-8ca6-85cb8b7d0f26

	/// Registros y valor en Ámbar o Rojo por antigüedad.
	measure 'Registros Antiguedad' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ), fact_kardex[alerta_antiguedad] IN { "Ámbar", "Rojo" } )
		formatString: 0
		displayFolder: 03 Criterios
		lineageTag: 6e016022-ec84-41c3-a6d2-2a8167c664c0

	/// Registros y valor en Ámbar o Rojo por antigüedad.
	measure 'Valor Antiguedad' =
			
			CALCULATE ( [Valorizacion Kardex], fact_kardex[alerta_antiguedad] IN { "Ámbar", "Rojo" } )
		formatString: #,0
		displayFolder: 03 Criterios
		lineageTag: aa8779ab-087f-4ed5-861b-d24b4d332fb8

	/// "No alineado" si hay registros en Ámbar o Rojo; "Alineado" si no.
	measure 'Eval Antiguedad' = IF ( [Registros Antiguedad] > 0, "No alineado", "Alineado" )
		displayFolder: 03 Criterios
		lineageTag: 47d6931e-ff8b-4e69-9ffe-9029cc7869c4

	/// Registros y valor con fecha de última compra posterior al cierre del mes.
	measure 'Registros FULCOM Futura' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ), fact_kardex[flag_fulcom_futura] = TRUE () )
		formatString: 0
		displayFolder: 03 Criterios
		lineageTag: 7a2721b9-dafa-42cf-b9ea-66d446868a8e

	/// Registros y valor con fecha de última compra posterior al cierre del mes.
	measure 'Valor FULCOM Futura' =
			
			CALCULATE ( [Valorizacion Kardex], fact_kardex[flag_fulcom_futura] = TRUE () )
		formatString: 0
		displayFolder: 03 Criterios
		lineageTag: f3214146-f5ce-4e54-b1cf-19549c9c9a33

	/// "Crítico" si hay FULCOM futuras; "Correcto" si no.
	measure 'Eval FULCOM Futura' = IF ( [Registros FULCOM Futura] > 0, "Crítico", "Correcto" )
		displayFolder: 03 Criterios
		lineageTag: ef8739fb-3f3b-4bbf-a2db-78990490f89a

	/// Registros y valor con factor de conversión inválido (vacío o ≤ 0) o distinto de 1.
	measure 'Registros Conversion' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ), fact_kardex[alerta_conversion] IN { "Inválido", "Revisar" } )
		formatString: 0
		displayFolder: 03 Criterios
		lineageTag: cf54be9e-1933-49cd-a9ac-94112b3018ef

	/// Registros y valor con factor de conversión inválido (vacío o ≤ 0) o distinto de 1.
	measure 'Valor Conversion' =
			
			CALCULATE ( [Valorizacion Kardex], fact_kardex[alerta_conversion] IN { "Inválido", "Revisar" } )
		formatString: #,0
		displayFolder: 03 Criterios
		lineageTag: 120b2d50-ae8f-441c-a1ad-07474d5f745f

	/// "Revisar" si hay conversiones inválidas o distintas de 1; "Ok" si no.
	measure 'Eval Conversion' = IF ( [Registros Conversion] > 0, "Revisar", "Ok" )
		displayFolder: 03 Criterios
		lineageTag: b1a2a40b-639c-4ab9-9855-5b9358b8148e

	/// Registros y valor cuya valorización difiere de stock × costo en más de $1.
	measure 'Registros Dif Valorizacion' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ), fact_kardex[flag_dif_valorizacion] = TRUE () )
		formatString: 0
		displayFolder: 03 Criterios
		lineageTag: c59a5db0-5b06-4446-a5cb-5a265c76ef7c

	/// Registros y valor cuya valorización difiere de stock × costo en más de $1.
	measure 'Valor Dif Valorizacion' =
			
			CALCULATE ( [Valorizacion Kardex], fact_kardex[flag_dif_valorizacion] = TRUE () )
		formatString: #,0
		displayFolder: 03 Criterios
		lineageTag: 44a17ce6-7690-4e09-9438-6b1b61bda42a

	/// "Revisar" si hay diferencias de valorización; "Ok" si no.
	measure 'Eval Valorizacion' = IF ( [Registros Dif Valorizacion] > 0, "Revisar", "Ok" )
		displayFolder: 03 Criterios
		lineageTag: 1d2263ca-c441-4c4b-b1e9-0bda6c35aed8

	/// Registros cuyo SKU aparece más de una vez en el mismo mes, y su valor.
	measure 'Registros Duplicados' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ), fact_kardex[flag_duplicado] = TRUE () )
		formatString: 0
		displayFolder: 03 Criterios
		lineageTag: 61b46bb7-26c9-4899-b15d-2e84e4a46afa

	/// Registros cuyo SKU aparece más de una vez en el mismo mes, y su valor.
	measure 'Valor Duplicados' =
			
			CALCULATE ( [Valorizacion Kardex], fact_kardex[flag_duplicado] = TRUE () )
		formatString: #,0
		displayFolder: 03 Criterios
		lineageTag: 088f660a-2afd-4e7e-a2d4-63418ac15a1b

	/// "Revisar" si hay SKU duplicados; "Ok" si no.
	measure 'Eval Duplicados' = IF ( [Registros Duplicados] > 0, "Revisar", "Ok" )
		displayFolder: 03 Criterios
		lineageTag: 97e00318-b5f5-49d5-9c80-de60fe284416

	/// Registros y valor sin canje (P0) en Rojo: pérdida casi segura, base para la provisión.
	measure 'Registros P0 Rojo' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ),
			    fact_kardex[POLITICA CJE AL 30SEP] = "P0", fact_kardex[alerta_antiguedad] = "Rojo" )
		formatString: 0
		displayFolder: 03 Criterios
		lineageTag: 19613a9d-811c-465d-b870-7598804f2dcf

	/// Registros y valor sin canje (P0) en Ámbar.
	measure 'Registros P0 Ambar' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ),
			    fact_kardex[POLITICA CJE AL 30SEP] = "P0", fact_kardex[alerta_antiguedad] = "Ámbar" )
		formatString: 0
		displayFolder: 03 Criterios
		lineageTag: 8072bb83-3eb1-4634-8a48-5398f022ed29

	/// Registros y valor sin canje (P0) en Rojo: pérdida casi segura, base para la provisión.
	measure 'Valor P0 Rojo' =
			
			CALCULATE ( [Valorizacion Kardex],
			    fact_kardex[POLITICA CJE AL 30SEP] = "P0", fact_kardex[alerta_antiguedad] = "Rojo" )
		formatString: #,0
		displayFolder: 03 Criterios
		lineageTag: 72878d95-bac7-4a82-9005-2c482400b1f3

	/// Registros y valor sin canje (P0) en Ámbar.
	measure 'Valor P0 Ambar' =
			
			CALCULATE ( [Valorizacion Kardex],
			    fact_kardex[POLITICA CJE AL 30SEP] = "P0", fact_kardex[alerta_antiguedad] = "Ámbar" )
		formatString: #,0
		displayFolder: 03 Criterios
		lineageTag: a3b6b39d-1bf6-4061-a373-c67bc9d50d76

	/// Suma de P0 en Rojo y en Ámbar.
	measure 'Registros P0 Envejecidos' = [Registros P0 Rojo] + [Registros P0 Ambar]
		formatString: 0
		displayFolder: 03 Criterios
		lineageTag: 2b0bc5c9-5022-4e19-bc79-c4e579747883

	/// Suma de P0 en Rojo y en Ámbar.
	measure 'Valor P0 Envejecidos' = [Valor P0 Rojo] + [Valor P0 Ambar]
		formatString: #,0
		displayFolder: 03 Criterios
		lineageTag: cafb1f89-f914-4b3b-8cec-346c2b1ed427

	/// "Riesgo alto" si hay P0 en Rojo; "Revisar" si solo hay P0 en Ámbar; "Ok" si no hay.
	measure 'Eval P0 Envejecidos' =
			
			SWITCH (
			    TRUE (),
			    [Registros P0 Rojo] > 0, "Riesgo alto",
			    [Registros P0 Ambar] > 0, "Revisar",
			    "Ok"
			)
		displayFolder: 03 Criterios
		lineageTag: be0f7fde-c271-4275-a50e-616ed6e78117

	/// Registros con alguna columna original vacía, y su valor.
	measure 'Registros Errores Datos' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ), fact_kardex[tiene_nulos] = TRUE () )
		formatString: 0
		displayFolder: 03 Criterios
		lineageTag: 83eafe37-665e-4088-8696-28bd84b08c27

	/// Registros con alguna columna original vacía, y su valor.
	measure 'Valor Errores Datos' =
			
			CALCULATE ( [Valorizacion Kardex], fact_kardex[tiene_nulos] = TRUE () )
		formatString: #,0
		displayFolder: 03 Criterios
		lineageTag: 307d6817-7be2-4aa3-9052-3e63b3af41e2

	/// "Corregir" si hay registros con datos faltantes; "Ok" si no.
	measure 'Eval Errores Datos' = IF ( [Registros Errores Datos] > 0, "Corregir", "Ok" )
		displayFolder: 03 Criterios
		lineageTag: e80f493c-e6c6-4502-aba6-d8571ab04f84

	/// Valorización del mes anterior al seleccionado. Responde a filtros de línea.
	measure 'Valorizacion Mes Anterior' =
			
			VAR m = MAX ( dim_calendario[idx_mes] )
			RETURN
			    CALCULATE ( [Valorizacion Kardex],
			        REMOVEFILTERS ( dim_calendario ), dim_calendario[idx_mes] = m - 1 )
		formatString: #,0
		displayFolder: 03 Criterios
		lineageTag: b0cd70a1-65a8-449b-bdd7-56b118bde56d

	/// Cambio de valorización contra el mes anterior, en CLP. Vacía en enero. Solo en CLP.
	measure 'Variacion CLP' =
			
			IF ( MAX ( dim_calendario[idx_mes] ) = 1, BLANK (),
			    [Valorizacion Kardex] - [Valorizacion Mes Anterior] )
		formatString: #,0
		displayFolder: 03 Criterios
		lineageTag: 8f5fd6fa-e0ab-48b8-82e7-2f1d2a354128

	/// Variación CLP como proporción del mes anterior.
	measure 'Variacion %' = DIVIDE ( [Variacion CLP], ABS ( [Valorizacion Mes Anterior] ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: 03 Criterios
		lineageTag: 9f3785d2-320d-4126-bb6d-9a503ea595a1

	/// "Revisar" si la variación es ≥ 5 %; "Ok" si no; "Sin mes anterior" en enero.
	measure 'Eval Variacion' =
			
			IF ( MAX ( dim_calendario[idx_mes] ) = 1, "Sin mes anterior",
			    IF ( ABS ( [Variacion %] ) >= [Umbral Variacion], "Revisar", "Ok" ) )
		displayFolder: 03 Criterios
		lineageTag: 7f1d827e-66ed-4b28-82f2-ce3fd625729a

	/// Registros en estado general REVISAR, y su valor.
	measure 'Registros Revisar' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ), fact_kardex[estado_general] = "REVISAR" )
		formatString: 0
		displayFolder: 03 Criterios
		lineageTag: 99a74334-62aa-450d-a878-dccc4b5bc65e

	/// Registros en estado general REVISAR, y su valor.
	measure 'Valor Revisar' =
			
			CALCULATE ( [Valorizacion Kardex], fact_kardex[estado_general] = "REVISAR" )
		formatString: #,0
		displayFolder: 03 Criterios
		lineageTag: ac67f044-2bf9-4444-9d4d-d7c6a51de348

	/// Número de SKU distintos (sin contar registros sin SKU).
	measure 'SKU Unicos' = DISTINCTCOUNTNOBLANK ( fact_kardex[CODIGO] )
		formatString: 0
		displayFolder: 05 SKU
		lineageTag: 41e50650-9b3b-46ca-bb1b-d028ebac8755

	/// SKU distintos del mes anterior.
	measure 'SKU Unicos Mes Anterior' =
			
			VAR m = MAX ( dim_calendario[idx_mes] )
			RETURN
			    CALCULATE ( [SKU Unicos], REMOVEFILTERS ( dim_calendario ), dim_calendario[idx_mes] = m - 1 )
		formatString: 0
		displayFolder: 05 SKU
		lineageTag: b0ad88d0-9fc0-4c23-9187-cf9e4c2ac65c

	/// Cambio en SKU únicos contra el mes anterior. Igual a SKU Nuevos − SKU Salieron.
	measure 'Variacion SKU' =
			
			IF ( MAX ( dim_calendario[idx_mes] ) = 1, BLANK (), [SKU Unicos] - [SKU Unicos Mes Anterior] )
		formatString: 0
		displayFolder: 05 SKU
		lineageTag: 17188bd0-bc59-472a-8c59-ecd3b67d4ea7

	/// SKU que no existían el mes anterior.
	measure 'SKU Nuevos' =
			
			CALCULATE ( DISTINCTCOUNTNOBLANK ( fact_kardex[CODIGO] ), fact_kardex[flag_sku_nuevo] = TRUE () )
		formatString: 0
		displayFolder: 05 SKU
		lineageTag: 3a6e2c4c-3c99-4ba0-885e-b297fc9f502d

	/// SKU que estaban el mes anterior y ya no aparecen.
	measure 'SKU Salieron' =
			
			VAR m = MAX ( dim_calendario[idx_mes] )
			VAR actuales = VALUES ( fact_kardex[CODIGO] )
			VAR anteriores =
			    CALCULATETABLE ( VALUES ( fact_kardex[CODIGO] ),
			        REMOVEFILTERS ( dim_calendario ), dim_calendario[idx_mes] = m - 1 )
			RETURN
			    IF ( m = 1, BLANK (), COUNTROWS ( EXCEPT ( anteriores, actuales ) ) )
		formatString: 0
		displayFolder: 05 SKU
		lineageTag: 576134c0-ae41-46cd-b2f4-f8b76b59c755

	/// Evaluación del criterio de la fila ("Ok", "Revisar", "Crítico", etc.).
	measure 'Criterio Evaluacion' =
			
			SWITCH (
			    SELECTEDVALUE ( dim_criterio[orden] ),
			    1, [Eval Conciliacion],
			    2, [Eval Variacion],
			    3, [Eval Antiguedad],
			    4, [Eval FULCOM Futura],
			    5, [Eval Conversion],
			    6, [Eval Valorizacion],
			    7, [Eval Duplicados],
			    8, [Eval P0 Envejecidos],
			    9, [Eval Errores Datos]
			)
		displayFolder: 04 Semáforo
		lineageTag: 4ecbac20-032e-460e-9903-c697fa53c974

	/// Registros afectados por el criterio. Vacía para Kardex vs. Balanza y variación mensual.
	measure 'Criterio Registros' =
			
			SWITCH (
			    SELECTEDVALUE ( dim_criterio[orden] ),
			    3, [Registros Antiguedad],
			    4, [Registros FULCOM Futura],
			    5, [Registros Conversion],
			    6, [Registros Dif Valorizacion],
			    7, [Registros Duplicados],
			    8, [Registros P0 Envejecidos],
			    9, [Registros Errores Datos]
			)
		formatString: 0
		displayFolder: 04 Semáforo
		lineageTag: 719591c8-b575-4e13-906c-e0635aec001b

	/// Valor afectado por el criterio; para Kardex vs. Balanza es la diferencia y para variación, la variación en CLP.
	measure 'Criterio Valor' =
			
			SWITCH (
			    SELECTEDVALUE ( dim_criterio[orden] ),
			    1, [Diferencia],
			    2, [Variacion CLP],
			    3, [Valor Antiguedad],
			    4, [Valor FULCOM Futura],
			    5, [Valor Conversion],
			    6, [Valor Dif Valorizacion],
			    7, [Valor Duplicados],
			    8, [Valor P0 Envejecidos],
			    9, [Valor Errores Datos]
			)
		formatString: #,0
		displayFolder: 04 Semáforo
		lineageTag: f9deff74-827b-45a8-90d2-8f70fb55ec3c

	/// Gravedad de la evaluación: 0 verde, 1 ámbar, 2 rojo, vacío sin evaluación. Usar para íconos y colores.
	measure 'Criterio Nivel' =
			
			VAR e = [Criterio Evaluacion]
			RETURN
			    SWITCH (
			        TRUE (),
			        e IN { "Ok", "Correcto", "Alineado", "Conciliado" }, 0,
			        e IN { "Revisar", "No alineado", "Corregir" }, 1,
			        e IN { "Crítico", "Riesgo alto", "No conciliado", "Sin balanza" }, 2,
			        BLANK ()
			    )
		formatString: 0
		displayFolder: 04 Semáforo
		lineageTag: 73366849-c2bf-4805-a36b-c822f35758a8

	/// Porcentaje del valor que representa cada categoría de antigüedad. Usar con dim_alerta[alerta].
	measure '% Valor por Alerta' =
			
			DIVIDE ( [Valorizacion Kardex], CALCULATE ( [Valorizacion Kardex], REMOVEFILTERS ( dim_alerta ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Antigüedad y Canje
		lineageTag: d35b28b7-5348-4f8b-8006-429e860f5d15

	/// Valor en Rojo y su porcentaje del valor total.
	measure 'Valor Rojo' =
			
			CALCULATE ( [Valorizacion Kardex], fact_kardex[alerta_antiguedad] = "Rojo" )
		formatString: #,0
		displayFolder: 06 Antigüedad y Canje
		lineageTag: 9a8743a3-47c9-4c95-a98c-310738873817

	/// Valor en Rojo y su porcentaje del valor total.
	measure '% Valor Rojo' = DIVIDE ( [Valor Rojo], [Valorizacion Kardex] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Antigüedad y Canje
		lineageTag: b91ca2c1-2ef4-4647-a648-ad2a2ade4ead

	/// Valor en Ámbar y su porcentaje del valor total.
	measure 'Valor Ambar' =
			
			CALCULATE ( [Valorizacion Kardex], fact_kardex[alerta_antiguedad] = "Ámbar" )
		formatString: #,0
		displayFolder: 06 Antigüedad y Canje
		lineageTag: 810f2e10-cae4-4909-9f18-3cd7e78540e5

	/// Valor en Ámbar y su porcentaje del valor total.
	measure '% Valor Ambar' = DIVIDE ( [Valor Ambar], [Valorizacion Kardex] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Antigüedad y Canje
		lineageTag: 02da1b0a-b0a2-45e6-9448-217ed8392606

	/// Días promedio desde la última compra, ponderados por valor. Excluye registros sin fecha válida o con valor ≤ 0.
	measure 'Antiguedad Ponderada' =
			
			VAR registros =
			    FILTER ( fact_kardex,
			        NOT ISBLANK ( fact_kardex[dias_antiguedad] ) && fact_kardex[VALORIZACION] > 0 )
			RETURN
			    DIVIDE (
			        SUMX ( registros, fact_kardex[dias_antiguedad] * fact_kardex[VALORIZACION] ),
			        SUMX ( registros, fact_kardex[VALORIZACION] )
			    )
		formatString: 0
		displayFolder: 06 Antigüedad y Canje
		lineageTag: 99afac50-b34a-46b8-ae43-34653ad519fc

	/// Valor y registros con canje (P1) en Ámbar o Rojo: lo que compras puede recuperar con el proveedor.
	measure 'Valor Recuperable Canje' =
			
			CALCULATE ( [Valorizacion Kardex],
			    fact_kardex[POLITICA CJE AL 30SEP] = "P1",
			    fact_kardex[alerta_antiguedad] IN { "Ámbar", "Rojo" } )
		formatString: #,0
		displayFolder: 06 Antigüedad y Canje
		lineageTag: 3bff8de5-1393-4f84-ae62-71c375b482ea

	/// Valor y registros con canje (P1) en Ámbar o Rojo: lo que compras puede recuperar con el proveedor.
	measure 'Registros Recuperable Canje' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ),
			    fact_kardex[POLITICA CJE AL 30SEP] = "P1",
			    fact_kardex[alerta_antiguedad] IN { "Ámbar", "Rojo" } )
		formatString: 0
		displayFolder: 06 Antigüedad y Canje
		lineageTag: 17de5fcd-2852-4697-96d8-aa9d22f20347

	/// Registros y valor a 30 días o menos de pasar a Rojo (151–180 días). Alerta temprana.
	measure 'Registros Proximo Rojo' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ), fact_kardex[flag_proximo_rojo] = TRUE () )
		formatString: 0
		displayFolder: 06 Antigüedad y Canje
		lineageTag: 6bba4779-1d9c-4576-8316-9aa71c249f3a

	/// Registros y valor a 30 días o menos de pasar a Rojo (151–180 días). Alerta temprana.
	measure 'Valor Proximo Rojo' =
			
			CALCULATE ( [Valorizacion Kardex], fact_kardex[flag_proximo_rojo] = TRUE () )
		formatString: #,0
		displayFolder: 06 Antigüedad y Canje
		lineageTag: b4f6ea8c-90d1-4e90-aaa7-b9288e2a26ef

	/// Registros y valor que pasaron a Rojo este mes.
	measure 'Registros Migro Rojo' =
			
			CALCULATE ( COUNTROWS ( fact_kardex ), fact_kardex[flag_migro_a_rojo] = TRUE () )
		formatString: 0
		displayFolder: 06 Antigüedad y Canje
		lineageTag: 1f8340e9-c98c-41b1-aaaf-42056a442e02

	/// Registros y valor que pasaron a Rojo este mes.
	measure 'Valor Migro Rojo' =
			
			CALCULATE ( [Valorizacion Kardex], fact_kardex[flag_migro_a_rojo] = TRUE () )
		formatString: #,0
		displayFolder: 06 Antigüedad y Canje
		lineageTag: 13c296ed-3880-4f09-a101-7c34bdd0bf90

	/// Porcentaje acumulado del valor en Rojo, del SKU más grande al más pequeño. Usar en tabla o gráfica por SKU.
	measure 'Pareto % Acumulado' =
			
			VAR actual = [Valor Rojo]
			VAR total = CALCULATE ( [Valor Rojo], REMOVEFILTERS ( dim_producto[CODIGO] ) )
			VAR tabla = ADDCOLUMNS ( ALL ( dim_producto[CODIGO] ), "@valor", [Valor Rojo] )
			VAR acumulado = SUMX ( FILTER ( tabla, [@valor] >= actual ), [@valor] )
			RETURN
			    IF ( ISBLANK ( actual ), BLANK (), DIVIDE ( acumulado, total ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 06 Antigüedad y Canje
		lineageTag: 32a838a9-4e6b-43fb-8431-3166b1a44626

	/// Número de SKU que concentran el 80 % del valor en Rojo.
	measure 'SKU Pareto' =
			
			COUNTROWS (
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_producto[CODIGO] ), "@acum", [Pareto % Acumulado] ),
			        NOT ISBLANK ( [@acum] ) && [@acum] <= [Pareto Pct]
			    )
			)
		formatString: 0
		displayFolder: 06 Antigüedad y Canje
		lineageTag: 3525c9ef-960b-4a22-afd5-9be00b9b61d8

	/// Saldo de la balanza del mes anterior al seleccionado.
	measure 'Saldo Balanza Mes Anterior' =
			
			VAR m = MAX ( dim_calendario[idx_mes] )
			RETURN
			    CALCULATE ( [Saldo Balanza], REMOVEFILTERS ( dim_calendario ), dim_calendario[idx_mes] = m - 1 )
		formatString: #,0
		displayFolder: 07 Variación
		lineageTag: bb0fcfd2-2f04-4ab2-bda4-8f78fa1f612e

	/// Cambio del saldo de balanza contra el mes anterior, en CLP. Vacía en enero.
	measure 'Variacion Balanza CLP' =
			
			IF ( MAX ( dim_calendario[idx_mes] ) = 1, BLANK (),
			    [Saldo Balanza] - [Saldo Balanza Mes Anterior] )
		formatString: #,0
		displayFolder: 07 Variación
		lineageTag: 682b6172-7337-4101-863c-286eaae8a251

	/// Variación de la balanza como proporción del mes anterior.
	measure 'Variacion Balanza %' =
			
			DIVIDE ( [Variacion Balanza CLP], ABS ( [Saldo Balanza Mes Anterior] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Variación
		lineageTag: 06206b5a-a90f-4ae0-960d-c69baaeb5b4b

	/// "Revisar" si la variación de la balanza es ≥ 5 %; "Ok" si no; "Sin mes anterior" en enero.
	measure 'Eval Variacion Balanza' =
			
			IF ( MAX ( dim_calendario[idx_mes] ) = 1, "Sin mes anterior",
			    IF ( ABS ( [Variacion Balanza %] ) >= [Umbral Variacion], "Revisar", "Ok" ) )
		displayFolder: 07 Variación
		lineageTag: dacc4bea-1bb5-4542-900a-437c3d0cc900

	/// Parte de la variación total que explica cada SKU. Usar en tabla por SKU; suma 100 %.
	measure 'Contribucion %' =
			
			DIVIDE ( [Variacion CLP], CALCULATE ( [Variacion CLP], REMOVEFILTERS ( dim_producto[CODIGO] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 07 Variación
		lineageTag: f130def9-4c9a-43be-94f6-880fb4ca1514

	/// Variación en CLP sin signo. Ordenar por ella muestra arriba los cambios grandes, suban o bajen.
	measure 'Variacion CLP Absoluta' = ABS ( [Variacion CLP] )
		formatString: #,0
		displayFolder: 07 Variación
		lineageTag: ac4fa4cc-8b70-40f3-a5b8-e2b4bcc8e44e

	/// Número de registros del Kardex.
	measure Registros = COUNTROWS ( fact_kardex )
		formatString: 0
