	/// 1 en CLP; tipo de cambio de cierre del mes en MXN.
	measure 'Factor Moneda' =
			
			IF ( [Moneda Seleccionada] = "MXN", MAX ( dim_calendario[tc_clp_mxn] ), 1 )
		formatString: 0.0000
		displayFolder: 09 Moneda
