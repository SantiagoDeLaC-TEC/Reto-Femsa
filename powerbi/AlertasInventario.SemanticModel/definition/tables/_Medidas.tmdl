		lineageTag: 8567f9d5-92db-4929-94b9-d44efc393431

	/// Valorización sumada sin signo, para que errores positivos y negativos no se cancelen.
	measure 'Valor Absoluto Kardex' = SUMX ( fact_kardex, ABS ( fact_kardex[VALORIZACION] ) )
		formatString: #,0
		displayFolder: 08 Calidad de Datos
		lineageTag: a5e53671-fdbc-4983-b046-6b93520473cd

	/// Porcentaje de registros sin datos faltantes.
	measure '% Registros Sin Errores' = 1 - DIVIDE ( [Registros Errores Datos], [Registros] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 08 Calidad de Datos
