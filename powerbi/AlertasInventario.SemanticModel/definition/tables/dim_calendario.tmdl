		sourceColumn: periodo_etiqueta
		sortByColumn: idx_mes

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column tc_clp_mxn
		dataType: double
		lineageTag: d5c48d1c-016d-46b3-be14-cf884c781c30
		summarizeBy: sum
		sourceColumn: tc_clp_mxn

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition dim_calendario = m
		mode: import
		queryGroup: 04_Dimensiones
		source =
				let
				    Archivos = Archivos_SharePoint,
				    Kardex = Table.SelectRows(Archivos, each
				        Text.EndsWith([Folder Path], "/" & CarpetaRaiz & "Kardex/")
				        and Text.StartsWith([Name], "kardex_")
				        and [Extension] = ".xlsx"),
				    Periodos = List.Sort(List.Distinct(List.Transform(Kardex[Name], each
				        Date.EndOfMonth(Date.FromText(
				            Text.BetweenDelimiters(_, "kardex_", ".xlsx") & "-01",
				            [Format = "yyyy-MM-dd"]))))),
				    Tabla = Table.FromList(Periodos, Splitter.SplitByNothing(), {"periodo"}),
				    Tipo = Table.TransformColumnTypes(Tabla, {{"periodo", type date}}),
				    ConIndice = Table.AddIndexColumn(Tipo, "idx_mes", 1, 1, Int64.Type),
				    Anio = Table.AddColumn(ConIndice, "anio", each Date.Year([periodo]), Int64.Type),
				    Mes = Table.AddColumn(Anio, "mes", each Date.Month([periodo]), Int64.Type),
				    NombreMes = Table.AddColumn(Mes, "nombre_mes", each
				        Date.ToText([periodo], [Format = "MMM yyyy", Culture = "es-MX"]), type text),
				    Ultimo = List.Max(Periodos),
				    Etiqueta = Table.AddColumn(NombreMes, "periodo_etiqueta", each
				        if [periodo] = Ultimo then "Último mes" else [nombre_mes], type text),
				    ConTC = Table.NestedJoin(Etiqueta, {"periodo"}, TipoCambio, {"periodo"}, "tc", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(ConTC, "tc", {"tc_clp_mxn"}),
				    Ordenada = Table.Sort(Expandido, {{"periodo", Order.Ascending}})
				in
				    Ordenada

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

