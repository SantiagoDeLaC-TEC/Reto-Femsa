		variation Variation
			isDefault
			relationship: 106227e0-82e5-4910-a5f5-89d4b961ec24
			defaultHierarchy: LocalDateTable_079d5d57-6bb9-4b67-bc27-ad34984fcaff.'Jerarquía de fechas'

