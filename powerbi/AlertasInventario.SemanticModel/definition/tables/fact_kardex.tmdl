	partition fact_kardex = m
		mode: import
		queryGroup: 03_Hechos
		source =
				let
				    Origen = Kardex_Limpio,
				    Param = (nombre as text) => Number.From(Parametros{[parametro = nombre]}[valor]),
				    DiasVerde = Param("dias_verde"),
				    DiasRojo = Param("dias_rojo"),
				    DiasProximoRojo = Param("dias_proximo_rojo"),
				    TolValorizacion = Param("tol_valorizacion"),
				    TolConversion = Param("tol_conversion"),
				
				    // Antigüedad
				    FulcomNula = Table.AddColumn(Origen, "flag_fulcom_nula",
				        each [FULCOM] = null, type logical),
				    FulcomFutura = Table.AddColumn(FulcomNula, "flag_fulcom_futura",
				        each [FULCOM] <> null and [FULCOM] > [periodo], type logical),
				    Dias = Table.AddColumn(FulcomFutura, "dias_antiguedad",
				        each if [flag_fulcom_nula] or [flag_fulcom_futura] then null
				             else Duration.Days([periodo] - [FULCOM]), Int64.Type),
				    Meses = Table.AddColumn(Dias, "meses_antiguedad",
				        each if [dias_antiguedad] = null then null
				             else (Date.Year([periodo]) - Date.Year([FULCOM])) * 12
				                  + Date.Month([periodo]) - Date.Month([FULCOM]), Int64.Type),
				    AlertaAntiguedad = Table.AddColumn(Meses, "alerta_antiguedad",
				        each if [flag_fulcom_nula] then "Sin fecha"
				             else if [flag_fulcom_futura] then "FULCOM futura"
				             else if [dias_antiguedad] <= DiasVerde then "Verde"
				             else if [dias_antiguedad] <= DiasRojo then "Ámbar"
				             else "Rojo", type text),
				    ProximoRojo = Table.AddColumn(AlertaAntiguedad, "flag_proximo_rojo",
				        each [dias_antiguedad] <> null and [dias_antiguedad] > DiasProximoRojo
				             and [dias_antiguedad] <= DiasRojo, type logical),
				    DiasParaRojo = Table.AddColumn(ProximoRojo, "dias_para_rojo",
				        each if [dias_antiguedad] = null then null
				             else DiasRojo - [dias_antiguedad], Int64.Type),
				
				    // Valorización
				    ValorCalculado = Table.AddColumn(DiasParaRojo, "valor_calculado",
				        each if [CODIGO] = null or [COSTO] = null then null
				             else [STOCK] * [COSTO], type number),
				    DifValorizacion = Table.AddColumn(ValorCalculado, "dif_valorizacion",
				        each if [VALORIZACION] = null or [valor_calculado] = null then null
				             else [VALORIZACION] - [valor_calculado], type number),
				    FlagDif = Table.AddColumn(DifValorizacion, "flag_dif_valorizacion",
				        each [dif_valorizacion] <> null
				             and Number.Abs([dif_valorizacion]) > TolValorizacion, type logical),
				    NaturalezaContraria = Table.AddColumn(FlagDif, "flag_naturaleza_contraria",
				        each [VALORIZACION] <> null and [VALORIZACION] < 0, type logical),
				
				    // Stock, costo y conversión
				    AlertaStock = Table.AddColumn(NaturalezaContraria, "alerta_stock",
				        each if [STOCK] = null then "Sin dato"
				             else if [STOCK] < 0 then "Negativo"
				             else if [STOCK] = 0 then "Cero"
				             else "Ok", type text),
				    AlertaCosto = Table.AddColumn(AlertaStock, "alerta_costo",
				        each if [COSTO] = null or [COSTO] <= 0 then "Inválido" else "Ok", type text),
				    AlertaConversion = Table.AddColumn(AlertaCosto, "alerta_conversion",
				        each if [#"UNID CONV"] = null or [#"UNID CONV"] <= 0 then "Inválido"
				             else if Number.Abs([#"UNID CONV"] - 1) > TolConversion then "Revisar"
				             else "Ok", type text),
				
				    // Duplicados (mismo SKU en el mismo periodo)
				    EnMemoria = Table.Buffer(AlertaConversion),
				    Conteo = Table.Group(Table.SelectRows(EnMemoria, each [CODIGO] <> null),
				        {"periodo", "CODIGO"}, {{"n_sku", each Table.RowCount(_), Int64.Type}}),
				    ConConteo = Table.NestedJoin(EnMemoria, {"periodo", "CODIGO"},
				        Conteo, {"periodo", "CODIGO"}, "conteo", JoinKind.LeftOuter),
				    Expandido = Table.ExpandTableColumn(ConConteo, "conteo", {"n_sku"}),
				    Duplicado = Table.AddColumn(Expandido, "flag_duplicado",
				        each [n_sku] <> null and [n_sku] > 1, type logical),
				    SinConteo = Table.RemoveColumns(Duplicado, {"n_sku"}),
				
				    // Estado general
				    Estado = Table.AddColumn(SinConteo, "estado_general",
				        each if List.Contains({"Rojo", "Sin fecha", "FULCOM futura"}, [alerta_antiguedad])
				                or [alerta_stock] <> "Ok" or [alerta_costo] <> "Ok"
				                or [alerta_conversion] <> "Ok" or [flag_dif_valorizacion]
				             then "REVISAR"
				             else if [alerta_antiguedad] = "Ámbar" then "MONITOREAR"
				             else "OK", type text),
				
				    // Comparación contra el mes anterior
				    PeriodoAnterior = Table.AddColumn(Estado, "periodo_anterior",
				        each Date.EndOfMonth(Date.AddMonths([periodo], -1)), type date),
				    EnMemoria2 = Table.Buffer(PeriodoAnterior),
				    PrimerPeriodo = List.Min(EnMemoria2[periodo]),
				    Unico = Table.SelectColumns(
				        Table.Distinct(Table.SelectRows(EnMemoria2, each [CODIGO] <> null), {"periodo", "CODIGO"}),
				        {"periodo", "CODIGO", "alerta_antiguedad", "estado_general"}),
				    ConAnterior = Table.NestedJoin(EnMemoria2, {"periodo_anterior", "CODIGO"},
				        Unico, {"periodo", "CODIGO"}, "anterior", JoinKind.LeftOuter),
				    Expandido2 = Table.ExpandTableColumn(ConAnterior, "anterior",
				        {"alerta_antiguedad", "estado_general"},
				        {"alerta_mes_anterior", "estado_mes_anterior"}),
				    SkuNuevo = Table.AddColumn(Expandido2, "flag_sku_nuevo",
				        each if [periodo] = PrimerPeriodo or [CODIGO] = null then null
				             else [estado_mes_anterior] = null, type logical),
				    MigroRojo = Table.AddColumn(SkuNuevo, "flag_migro_a_rojo",
				        each if [periodo] = PrimerPeriodo or [CODIGO] = null then null
				             else [alerta_antiguedad] = "Rojo"
				                  and [alerta_mes_anterior] <> null
				                  and [alerta_mes_anterior] <> "Rojo", type logical),
				    AlertaNueva = Table.AddColumn(MigroRojo, "es_alerta_nueva",
				        each if [periodo] = PrimerPeriodo or [CODIGO] = null then null
				             else [estado_general] = "REVISAR"
				                  and [estado_mes_anterior] <> "REVISAR", type logical),
				    Final = Table.RemoveColumns(AlertaNueva, {"periodo_anterior"})
				in
				    Final

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

